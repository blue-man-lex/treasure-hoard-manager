<form class="thm-premium-window thm-loot-window" autocomplete="off">
  
  <!-- HEADER -->
  <div class="thm-premium-header">
    <div class="thm-portrait-frame">
      <img class="thm-portrait-img" src="icons/svg/chest.svg" alt="Container">
    </div>
    <div class="header-info">
      <h1 class="thm-window-title" title="{{actor.name}}">{{actor.name}}</h1>
    </div>

    {{#if isGM}}
    <div class="header-controls">
      {{#if isCorpse}}
      <button type="button" class="configure-loot-btn" title="Настроить добычу (выбрать, что оставить в луте)">
        <i class="fas fa-filter"></i> <span>Настроить лут</span>
      </button>
      {{/if}}
      <div class="lock-controls">
        <label class="lock-toggle" title="{{#if isLocked}}Заперто{{else}}Открыто{{/if}}">
          <input type="checkbox" class="lock-checkbox" {{#if isLocked}}checked{{/if}}>
          <span class="lock-label">
            <i class="fas fa-lock{{#unless isLocked}}-open{{/unless}}"></i>
            <span>{{#if isLocked}}Заперто{{else}}Открыто{{/if}}</span>
          </span>
        </label>
      </div>
    </div>
    {{/if}}
  </div>

  <div class="loot-body">
    
    <!-- Items Grid -->
    <div class="items-grid">
      {{#if (and isLocked (not isGM))}}
        <!-- Сообщение для игроков когда контейнер заперт -->
        <div class="locked-message">
          <i class="fas fa-lock"></i>
          <div>Сундук заперт</div>
        </div>
      {{else}}
        {{#each items}}
          <div class="thm-item-slot rarity-{{this.rarity}} item-row inventory-item {{#if this.isExcluded}}thm-item-excluded{{/if}}" data-item-id="{{this.id}}" data-actor-id="{{../actor._id}}" {{#if ../isGM}}{{#if this.isExcluded}}title="Скрыто от игроков (ПКМ чтобы показать)"{{else}}title="Видно игрокам (ПКМ чтобы скрыть)"{{/if}}{{/if}}>
            <div class="thm-rarity-bg"></div>
            <img class="thm-item-icon" src="{{this.img}}" alt="{{this.name}}"/>
            {{#if (gt this.quantity 1)}}
              <span class="thm-item-qty">{{this.quantity}}</span>
            {{/if}}
            {{#if ../isGM}}
              {{#if this.isExcluded}}
                <span class="thm-item-badge thm-badge-hidden" title="Скрыто от игроков"><i class="fas fa-eye-slash"></i></span>
              {{/if}}
            {{/if}}
          </div>
        {{else}}
          <div class="empty-state" style="width: 100%;">
            <h3>Сундук пуст</h3>
          </div>
        {{/each}}
      {{/if}}
    </div>
  </div>

  <!-- ОБЛАСТЬ ДЕНЕГ -->
  {{#if hasCurrency}}
  <div class="currency-area">
    <div class="currency-title">Доступно денег:</div>
    <div class="thm-currency-block">
      {{{currencyHtml}}}
    </div>
  </div>
  {{/if}}

  <!-- FOOTER -->
  <div class="loot-footer">
    {{#if hasCurrency}}
    <button type="button" class="thm-btn take-currency-btn" title="Забрать все деньги">
      <i class="fas fa-coins"></i>
      Забрать деньги
    </button>
    {{/if}}
    
    <button type="button" class="thm-btn loot-all-btn">
      <i class="fas fa-gem"></i>
      Взять всё
    </button>
  </div>
</form>